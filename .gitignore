venv
.DS_Store
.idea
.gcloudignore
.git
.venv
__pycache__/
/setup.cfg
.ipynb_checkpoints
.env
Brewfile.lock.json
*.pdf

# Terraform
**/.terraform/*
**/terraform/terraform.tfstate.d
**/.terraform*
# Terraform lock files
*/.terraform.lock.hcl
.terraform.lock.hcl
*.terraform.lock.hcl 

# Data
*.csv
*.xlsx
*.xls
*.pkl
*.parquet
*.zip
*.ods

# outputs
*.pdf
*.jpg
*.png
*.pptx
*.ppt
*.docx

# Rendered presentations
*.html
*_files/

# Docker cache
.build-cache

# Python package manager lock files
poetry.lock

# Frontend dependencies (applies to all frontend frameworks)
frontend/node_modules/
frontend/.env*.local



frontend/.astro/
frontend/dist/

# Gateway runtime state (private keys, audit log)
gateway/state/*
!gateway/state/.gitkeep

.pytest_cache/
.ruff_cache/
eval_pack/

# Synthetic extract: commit the CSVs (overrides the global *.csv rule above)
!mcp_server/data/synthetic/*.csv

# Local board source. The global *.html rule is for rendered slides.
!local_view/index.html
!local_view/attack.html
# The attack lab writes operator-composed vectors here at runtime; keep them local.
local_view/saved_vectors.json

# Day 2 attack lab: keep attack keys, minted mandates, target configs and any tokens local.
day_2_attack/keys/
day_2_attack/mandates/
day_2_attack/targets/
day_2_attack/*.pem
day_2_attack/**/*.jwt

.tmp/

# MCP server write tool output
mcp_server/data/writes/
