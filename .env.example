APP_NAME=agent-mandate-hack
AWS_REGION=eu-west-2
ENVIRONMENT=local
REPO=agent-mandate-hack


SENTRY_DSN="dummy-dsn"



APP_URL=http://localhost:3000
AUTH_API_URL=<auth_api_url>


BACKEND_URL=http://localhost:8000


AWS_ACCOUNT_ID=<account_id>
GATEWAY_URL=http://localhost:8082

# The demo UI at localhost:8081/demo issues, revokes and calls through the gateway's /demo routes, which ask for
# no proof of who is calling. They are off unless this is 1. Uncomment on your own laptop to use the walkthrough.
# Leave it off on any gateway you post for Day 2: with it on, anyone can mint a mandate for any school.
# GATEWAY_DEMO=1

# optional: lets the gateway, or your agent, call a model
LITELLM_KEY=
LITELLM_BASE_URL=
